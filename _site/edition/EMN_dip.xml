    <body>
          <pb type="folio" n="[Fol. 1r]"/>
  <head>El Marq.s  de las Navas.</head>
  <p>de Lope</p>
  <castList>
  <castItem>De Fadriq Doristan</castItem>
  <castItem>don Felipe de Cardona</castItem>
  <castItem>d. diego de Cardona</castItem>
  <castItem>el Conde d Felis [rúbrica]</castItem>
  <castItem>Frutos Brauo</castItem>
  <castItem>bernardo - el marques</castItem>
  <castItem>- don Felipe</castItem>
  <castItem>- leonardo</castItem>
  <castItem>- mendozilla</castItem>
  <castItem>- feliciana</castItem>
  <castItem>- Gerarda</castItem>
  <castItem>- Laurencia</castItem>
  <castItem>- clara</castItem>
  <castItem>- bernardo</castItem>
  <castItem>- fadrique</castItem>
  <castItem>- antonio</castItem>
  <castItem>- Ludovico</castItem>
</castList>
          <pb type="folio" n="[Fol. 1v]"/>
  <castItem>don juo — Jordan</castItem>
  <castItem>musico — quadrado</castItem>
  <castItem>d. Luis — Vizente</castItem>
  <castItem>Jerarda — Sa Cata</castItem>
  <castItem>anto — Jordan</castItem>
  <castItem>Ludobico — escoriguela</castItem>
  <castItem>Clara — Sa germa</castItem>
  <castItem>Lacayo — Vizente</castItem>
  <castItem>D. henrique — mateo</castItem>
  <castItem>Berdo — germo</castItem>
  <castItem>Laurenzia — sa [ma hija ?]</castItem>
          <pb type="folio" n="[Fol. 2r]"/>
      <div type="act" n="1">
        <head>ACTO P°</head>
        <stage>Leonardo y Feliciana</stage>
        <sp>
        <speaker>&lt;Leo+Feli&gt;</speaker>
            <l n="1">al mismo Neron te ygualas</l>
        </sp>
        <sp>
        <speaker>Leo</speaker>
            <l n="2">mira q es gran nezedad</l>
            <l n="3">detener la voluntad</l>
            <l n="4">por q la pintan con alas.</l>
        </sp>
        <sp>
        <speaker>Feli</speaker>
            <l n="5">tus obras siempre tan &lt;-m&gt; malas</l>
            <l n="6">&lt;-para mi&gt; a quien las deues tan buenas</l>
            <l n="7">Leonardo a mi fin ordenas,</l>
            <l n="8">de q te vengo a deuer</l>
            <l n="9">quererle agora poner</l>
            <l n="10">a tantas injustas penas.</l>
        </sp>
        <sp>
        <speaker>&lt;feli+Leo&gt;</speaker>
            <l n="11">Sueltame la capa suelta,</l>
            <l n="12">suelta en paz, q  vna porfia</l>
            <l n="13">conuierte en descortesia</l>
            <l n="14">determinaçion resuelta.</l>
        </sp>
        <sp>
        <speaker>feli</speaker>
            <l n="15">y quando &lt;-ser?&gt; daras la buelta?</l>
        </sp>
        <sp>
        <speaker>Leo</speaker>
            <l n="16">luego q este pleyto acabe</l>
            <l n="17">q en pleytos y mas tan grabe</l>
            <l n="18">por mas q abreuiarle ynporte</l>
            <l n="19">el Almanac de la Corte</l>
            <l n="20">ningun Pronostico sabe</l>
        <pb type="folio" n="[Fol. 2v]"/>
            <l n="21">a Madrid voy q no voy</l>
            <l n="22">a Manila, o a la china</l>
            <l n="23">en cuya Mar Filipina</l>
            <l n="24">nueuo nauegante soy.</l>
            <l n="25">presto sabras q alli estoy</l>
            <l n="26">si otra jornada reçelas</l>
        </sp>
        <sp>
        <speaker>Fe</speaker>
            <l n="27">ya de q siruen cautelas</l>
            <l n="28">&lt;- si ha hecho&gt; quando mi desconfianza</l>
            <l n="29">llega a mirar tu mudanza</l>
            <l n="30">con alas y con espuelas</l>
            <l n="31">a pleytos dizes q vas</l>
            <l n="32">bien dizes quiero ayudarte</l>
            <l n="33">pues vas Leonardo a casarte</l>
            <l n="34">o por ventura lo estas:</l>
            <l n="35">no ay otro pleyto q mas</l>
            <l n="36">procure vn onbre venzer</l>
            <l n="37">&lt;-q aun&gt; muchos buenos suele haber</l>
            <l n="38">mas ninguno oy deçir</l>
            <l n="39">q dessease morir</l>
            <l n="40">primero q su muger.</l>
            <l n="41">buen pleyto llebas, procura</l>
            <l n="42">venzer tan gran differençia</l>
            <l n="43">q ha detener la sentençia</l>
            <l n="44">en la misma sepoltura</l>
            <l n="45">pero yo quedo segura</l>
            <l n="46">q la palabra q aqui</l>
          <pb type="folio" n="[Fol. 3r]"/>
            <l n="47">me quiebras Leonardo ansí.</l>
            <l n="48">sin q el ser noble me balga</l>
            <l n="49">hara q mui presto salga</l>
            <l n="50">la sentençia contra ti.</l>
            <l n="51">Engañasteme villano</l>
            <l n="52">siendo tu para mi mal</l>
            <l n="53">el primero desleal</l>
            <l n="54">q ha nacido Toledano.</l>
            <l n="55">el juramento y la mano</l>
            <l n="56">q de dios en la presençia</l>
            <l n="57">me diste, me da paçiençia</l>
            <l n="58">por q es razon q presuma</l>
            <l n="59">q le estas dando la pluma</l>
            <l n="60">para firmar la sentençia</l>
            <l n="61">No lograras la muger</l>
            <l n="62">de quien vas enamorado</l>
            <l n="63">o has de ser tan desdichado</l>
            <l n="64">q aun onrra no has de tener</l>
            <l n="65">q si os llegan a offender</l>
            <l n="66">las propias &lt;-a los mas sabios&gt;como lo esperes</l>
            <l n="67">aunq tan onrrado eres</l>
            <l n="68">y a los mas nobles y sabios</l>
            <l n="69">es por vengar los agrabios</l>
            <l n="70">q habeis hecho a otras mugeres</l>
            <l n="71">yo te he servido y de ti</l>
            <l n="72">llebo tan buen galardon</l>
            <l n="73">q espero q vna trayçion</l>
          <pb type="folio" n="[Fol. 3v]"/>
            <l n="74">te ynfame, y me venge a mi.</l>
            <l n="75">Vete pues ya te perdí</l>
            <l n="76">y tan yngrato conozes</l>
            <l part="I" n="77">mi verdad.</l>
        </sp>
        <sp>
        <speaker>Leo</speaker>
            <l part="F">no me des vozes</l>
            <l n="78">q aun sola tu voz me enfada</l>
        </sp>
        <sp>
        <speaker>Fel</speaker>
            <l n="79">mueras de mala estocada</l>
            <l n="80">antes q sus brazos gozes</l>
            <l n="81">Plega al çielo, pues el çielo</l>
            <l n="82">fue de tu maldad testigo</l>
            <l n="83">q a sus puertas enemigo</l>
            <l n="84">bañes &lt;-d&gt; con tu sangre el suelo</l>
        </sp>
        <stage>[cruz potenciada] Bernardo entre</stage>
        <sp>
        <speaker>Be</speaker>
            <l part="I" n="85">q es esto prima</l>
        </sp>
        <sp>
        <speaker>fe</speaker>
            <l part="F">q  apelo</l>
            <l n="86">de vn casamiento traydor</l>
            <l n="87">al çielo, Alcalde mayor.</l>
        </sp>
        <sp>
        <speaker>Be</speaker>
            <l n="88">has reñido con Leonardo</l>
        </sp>
        <sp>
        <speaker>feli</speaker>
            <l n="89">naçi con onrra Bernardo</l>
            <l n="90">q ya no trato de Amor</l>
            <l n="91">de aqui se parte a casar</l>
            <l part="I" n="92">a Madrid</l>
        </sp>
        <sp>
        <speaker>B</speaker>
            <l part="M">q dizes</l>
        </sp>
        <sp>
        <speaker>fe</speaker>
            <l part="F">digo</l>
            <l n="93">q me lo ha dicho el amigo</l>
            <l n="94">de quien mas suele fiar.</l>
        </sp>
        <sp>
        <speaker>Be</speaker>
            <l n="95">buen pago te viene a dar</l>
            <l n="96">tras tantas obligaçiones.</l>
        </sp>
        <sp>
        <speaker>feli</speaker>
            <l n="97">en llegando a sin razones</l>
            <l n="98">se pierde todo el amor.</l>
            <l n="99">tu veras como al traydor</l>
            <l n="100">le alcanzan mis maldiziones</l>
          <pb type="folio" n="[Fol. 4r]"/>
        </sp>
        <sp>
        <speaker>Be</speaker>
            <l n="101">yo estoy Feliçiana agora</l>
            <l n="102">para Madrid de camino</l>
            <l n="103">q a sus fiestas me preuino</l>
            <l n="104">por muchas cartas Leonora</l>
            <l n="105">quanta riqueza atesora</l>
            <l n="106">lustre, gala, y balentia</l>
            <l n="107">dizen q salir &lt;-aquel dia // porfia&gt;</l>
            <l n="108">y q ha de ser el espaçio</l>
            <l n="109">de la plaza de palaçio</l>
            <l n="110">çielo de Marte aquel dia.</l>
            <l n="111">Esta sola ocupaçion</l>
            <l n="112">poco me puede ynpedir</l>
            <l n="113">q no te pueda servir</l>
            <l n="114">prima en aqsta ocasion</l>
            <l n="115">si suele la dilaçion</l>
            <l n="116">desazer los casamientos</l>
            <l n="117">ponle pleyto y sus intentos</l>
            <l n="118">no llegen a executarse</l>
        </sp>
        <sp>
        <speaker>feli</speaker>
            <l n="119">bien se yo q es dilatarse</l>
            <l n="120">malograr sus pensamientos</l>
            <l n="121">pero tu solo te pones</l>
            <l n="122">a peligro de tener</l>
            <l n="123">disgusto y vna muger</l>
            <l n="124">con lagrimas y razones</l>
            <l n="125">ablanda los corazones</l>
            <l n="126">de los juezes mexor</l>
        </sp>
        <sp>
        <speaker>Be</speaker>
            <l n="127">el mexor procurador</l>
          <pb type="folio" n="[Fol. 4v]"/>
            <l n="128">de vn pleyto es el mismo dueño</l>
        </sp>
        <sp>
        <speaker>fel</speaker>
            <l n="129">no lo sere yo pequeno</l>
            <l n="130">&lt;-llebame?&gt; si quieres contigo yre</l>
            <l n="131">donde hasta el fin no tendre</l>
            <l n="132">gusto, descanso, ni sueño.</l>
            <l n="133">haz esto primo por mi</l>
            <l n="134">por mi ynoçençia, por ser</l>
            <l part="I" n="135">muger</l>
        </sp>
        <sp>
        <speaker>Be</speaker>
            <l part="F">quanto pueda hazer</l>
            <l n="136">hare señora por ti</l>
        </sp>
        <sp>
        <speaker>feli</speaker>
            <l part="I" n="137">luego voy contigo</l>
        </sp>
        <sp>
        <speaker>Be</speaker>
            <l part="F">sí</l>
        </sp>
        <sp>
        <speaker>feli</speaker>
            <l n="138">ya leonardo tu mudanza</l>
            <l n="139">juez riguroso alcanza</l>
            <l n="140">mira q offendida estoy</l>
            <l n="141">y mira q muger soy</l>
            <l n="142">donde es mayor la venganza</l>
        </sp>
        <stage>[cruz potenciada]don luis y don Juan de noche</stage>
        <sp>
        <speaker>lu</speaker>
            <l part="I" n="143">bueno esta el prado</l>
        </sp>
        <sp>
        <speaker>Ju</speaker>
            <l part="F">famoso</l>
            <l n="144">aunq menos gente viene</l>
            <l n="145">como ya va refrescando</l>
        </sp>
        <sp>
        <speaker>Lui</speaker>
            <l part="I" n="146">q ay de Fenis</l>
        </sp>
        <sp>
        <speaker>Ju</speaker>
            <l part="F">bolo Fenis</l>
        </sp>
        <sp>
        <speaker>Lui</speaker>
            <l part="I" n="147">q me deçis</l>
        </sp>
        <sp>
        <speaker>Ju</speaker>
            <l part="F">a otro nido</l>
            <l n="148">donde se ha visto q miente</l>
            <l n="149">la fama en llamarla sola</l>
            <l n="150">pues otro paxaro tiene</l>
        </sp>
        <sp>
        <speaker>Lui</speaker>
            <l n="151">no ay seguridad de brazos</l>
            <l n="152">ni aun de las almas a vezes.</l>
        </sp>
      </div>
